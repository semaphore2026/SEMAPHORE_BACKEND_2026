# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/semaphore_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production_2026
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google GCP OAuth Credentials
GOOGLE_CLIENT_ID=your_gcp_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_gcp_google_client_secret
